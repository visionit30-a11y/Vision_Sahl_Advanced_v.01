# ============================================================
#  Sahl Developer Platform - local environment example
#  Copy to .env (scripts/01-setup.ps1 does this automatically).
#  NEVER commit the real .env file.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=Sahl Developer Platform
APP_ENV=development
APP_VERSION=0.1.0

# ── Logging ─────────────────────────────────────────────────
# LOG_FORMAT: console (local) | json (staging/production)
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── API ─────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PostgreSQL ──────────────────────────────────────────────
# The application role must NOT have SUPERUSER or BYPASSRLS.
DATABASE_URL=postgresql+psycopg://sahl_app:CHANGE_ME@127.0.0.1:5432/sahl_dev

# ── Redis ───────────────────────────────────────────────────
# Phase 0: Redis is configured but not started locally yet.
# See docs/adr/ADR-0003-redis-deferred-verification.md
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0

# ── Frontend (Vite) ─────────────────────────────────────────
# Empty = same origin; the Vite dev server proxies /health to the API.
VITE_API_BASE_URL=
